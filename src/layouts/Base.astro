---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
interface Props { title?: string; description?: string; }
const { title, description } = Astro.props;
const site = 'Mikkelsen Photonics';
const fullTitle = title ? `${title} — ${site}` : `${site} — Niels Bohr Institute, University of Copenhagen`;
const desc = description ?? 'Quantum, nonlinear and nanoscale light–matter interactions. The Mikkelsen group at the Niels Bohr Institute, University of Copenhagen.';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{fullTitle}</title>
  <meta name="description" content={desc}>
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)}>
  <meta property="og:title" content={fullTitle}>
  <meta property="og:description" content={desc}>
  <meta property="og:type" content="website">
  <meta property="og:site_name" content={site}>
  <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)}>
  <meta property="og:image" content={new URL('/images/share.jpg', Astro.site)}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="Mikkelsen Photonics — Niels Bohr Institute, University of Copenhagen">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
  <Header />
  <main><slot /></main>
  <Footer />
</body>
</html>
