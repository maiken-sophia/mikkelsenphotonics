---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="This page does not exist on the Mikkelsen Photonics website." noindex>
<section>
  <div class="wrap">
    <p class="eyebrow">Error 404</p>
    <h1>Page not found</h1>
    <p class="muted prose">The page you were looking for has moved or does not exist. If you followed an older link, the material is most likely still here under a new address.</p>
    <p style="margin-top:20px"><a class="btn btn-accent arrow" href="/">Front page</a><a class="btn btn-ghost" href="/research">Research</a></p>
    <div class="links" style="max-width:44em;margin-top:26px">
      <a href="/discoveries">Discoveries</a>
      <a href="/publications">Publications</a>
      <a href="/people">People</a>
      <a href="/join">Join us</a>
      <a href="/contact">Contact</a>
    </div>
  </div>
</section>
</Base>
