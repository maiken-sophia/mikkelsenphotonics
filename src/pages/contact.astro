---
import Base from "../layouts/Base.astro";
---
<Base title="Contact">
<section class="contact">
  <img class="strip" src="/images/facade-detail.jpg" alt="Detail of the triangulated glass facade of the Niels Bohr Building." width="1600" height="1066">
  <div class="wrap">
    <p class="eyebrow">Contact</p>
    <h1>Mikkelsen Photonics</h1>
    <p class="muted">Professor Maiken H. Mikkelsen<br>Niels Bohr Institute, University of Copenhagen<br>Jagtvej 155, 2200 Copenhagen N, Denmark<br><a href="mailto:maiken.mikkelsen@nbi.ku.dk">maiken.mikkelsen@nbi.ku.dk</a></p>
  </div>
</section>
</Base>
<style>
.contact{padding-top:0}
.contact .strip{width:100%;height:170px;object-fit:cover;object-position:center 40%;margin-bottom:26px}
</style>
