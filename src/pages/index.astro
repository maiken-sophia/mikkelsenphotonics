---
import Base from '../layouts/Base.astro';
import ResearchCard from '../components/ResearchCard.astro';
import Covers from '../components/Covers.astro';
import schema from '../data/schema.json';
import { getCollection, render } from 'astro:content';

const areas = (await getCollection('research')).sort((a, b) => a.data.order - b.data.order);
const discoveries = (await getCollection('discoveries')).sort((a, b) => a.data.order - b.data.order);
const leader = (await getCollection('people')).find(p => p.data.leader);
const { Content: LeaderBio } = leader ? await render(leader) : { Content: null };
const rendered = await Promise.all(discoveries.map(async d => ({ ...d, Content: (await render(d)).Content })));
const jsonld = { '@context': 'https://schema.org', '@graph': [schema.website, schema.organization, schema.person] };
---
<Base jsonld={jsonld}>

<section class="hero">
  <div class="hero-grid">
    <div class="hero-text">
      <h1>What happens when light is confined to the scale of atoms?</h1>
      <p class="lede">We create electromagnetic environments with atomic-scale spatial structure and ultrafast temporal control — and study what they do to light, to quantum emitters, and to matter.</p>
      <a class="btn btn-accent arrow" href="/research">Explore our research</a><a class="btn btn-ghost" href="/join">We're hiring</a>
    </div>
    <figure class="hero-fig">
      <picture>
        <source type="image/webp" srcset="/images/hero-1000.webp 1000w, /images/hero-1400.webp 1400w, /images/hero-2000.webp 2000w" sizes="(max-width: 860px) 100vw, 46vw">
        <img src="/images/hero.jpg" alt="Artist's rendering of a gold nanodisk on a diamond membrane, with a picosecond light pulse arriving from above and a single silicon-vacancy emitter in the nanogap." width="1400" height="1413" fetchpriority="high">
      </picture>
      <figcaption>A nanogap cavity: a gold nanodisk on a diamond membrane, with a single emitter in the gap. Artist's rendering.</figcaption>
    </figure>
  </div>
</section>

{leader && (
<section>
  <div class="wrap leader-grid leader-home">
    <img class="framed" src={leader.data.photo} alt={`Portrait of ${leader.data.name}`} width="1050" height="700" loading="lazy">
    <div>
      <p class="eyebrow">Group leader</p>
      <h2>Professor {leader.data.name}</h2>
      <p class="muted">{leader.data.role}, Niels Bohr Institute · University of Copenhagen</p>
      <div class="prose">{leader.data.shortBio ? leader.data.shortBio.map(t => <p>{t}</p>) : <LeaderBio />}</div>
      <div class="links">
        <a href="/people">Biography</a>
        {leader.data.links.map(l => <a href={l.url}>{l.label}</a>)}
        <a href="/publications">Publications</a>
        <a href={`mailto:${leader.data.email}`}>Email</a>
      </div>
    </div>
  </div>
</section>
)}

<section>
  <div class="wrap two">
    <div class="prose">
      <p class="eyebrow">From enhancement to new physics</p>
      <h2>Light as a tool to control matter at the smallest scales</h2>
      <p>Most optical materials are described by their intrinsic properties — refractive index, nonlinear susceptibility, emission lifetime, response time. But these are not properties of the material alone. They depend on the electromagnetic environment the material sits in, including the vacuum itself.</p>
      <p>We build that environment to order. Our cavities confine light to gaps a few nanometers wide, where the field varies on the scale of a single exciton. Inside them, emitters radiate up to ten thousand times faster than in free space, nonlinear responses appear that no bulk coefficient predicts, and a slow material becomes an ultrafast detector.</p>
      <p>Much of nanophotonics, including our own early work, has asked how strongly an optical process can be enhanced. We now ask a different question: can an electromagnetic environment beyond anything found in nature create behavior that could not exist otherwise?</p>
    </div>
    <figure>
      <img class="framed" src="/images/sem.jpg" alt="Scanning electron micrograph of silver nanocubes on a gold film." width="900" height="652" loading="lazy">
      <figcaption>Silver nanocubes on a gold film. Each cube forms a cavity with the film beneath it; the gap is a few nanometers wide.</figcaption>
    </figure>
  </div>
</section>

<section id="research">
  <div class="wrap">
    <p class="eyebrow">Research</p>
    <h2>Four questions</h2>
    <div class="grid4">
      {areas.map(a => <ResearchCard slug={a.id} title={a.data.title} question={a.data.question} summary={a.data.summary} image={a.data.image} imageAlt={a.data.imageAlt} />)}
    </div>
  </div>
</section>

<section>
  <div class="wrap">
    <div class="head">
      <div><p class="eyebrow">Selected discoveries</p><h2>From fundamental physics to the clinic</h2></div>
      <a class="arrow" href="/discoveries">All discoveries</a>
    </div>
    <div class="grid5">
      {rendered.map(d => (
        <article class="d">
          {d.data.image ? <img class="framed" src={d.data.image} alt={d.data.imageAlt} loading="lazy" style="aspect-ratio:4/3;object-fit:cover;width:100%"> : <div class="tile">{d.data.tile}</div>}
          <h3>{d.data.title}</h3>
          <div class="dtext"><d.Content /></div>
          <p class="cite" set:html={d.data.citation.replace(/\*(.+?)\*/g, '<i>$1</i>') + ' · ' + (d.data.doi ? `<a class="arrow" href="https://doi.org/${d.data.doi}">Read the paper</a>` : d.data.url ? `<a class="arrow" href="${d.data.url}">Read the paper</a>` : '')} />
        </article>
      ))}
    </div>
  </div>
</section>

<Covers />

<section>
  <div class="wrap two top lab-two">
    <div class="prose">
      <p class="eyebrow">The lab</p>
      <h2>Built from the ground up</h2>
      <p>We are building the laboratory from the ground up in the Niels Bohr Institute's new building, established with a DKK 35 million RECRUIT award from the Novo Nordisk Foundation. Instruments arriving through 2027:</p>
      <ul class="muted">
        <li>Single-photon confocal microscopy and spectroscopy with time-correlated detection</li>
        <li>Tunable picosecond and femtosecond laser sources for ultrafast pump–probe spectroscopy</li>
        <li>Closed-cycle cryostats with magnetic fields for low-temperature magneto-optical spectroscopy</li>
        <li>Assembly of van der Waals heterostructures</li>
      </ul>
      <p>Nanofabrication is carried out in the NBI nanofabrication facilities and the DTU Nanolab cleanroom. The Niels Bohr Institute hosts world-leading groups in quantum optics, quantum photonics, and condensed-matter physics, and Copenhagen has strong quantum photonics and 2D-materials communities at both NBI and DTU.</p>
    </div>
    <div class="photos">
      <figure><img class="framed" src="/images/building.jpg" alt="The Niels Bohr Building on Jagtvej, its faceted glass facade and skybridge." width="1600" height="1067" loading="lazy"><figcaption>The Niels Bohr Building, Jagtvej 155.</figcaption></figure>
      <figure><img class="framed" src="/images/skybridge.jpg" alt="Inside the glazed bridge linking the two wings of the Niels Bohr Building." width="1600" height="1066" loading="lazy"><figcaption>The bridge between the two wings.</figcaption></figure>
    </div>
  </div>
</section>



<section class="join">
  <div class="wrap two top">
    <div class="prose">
      <p class="eyebrow">Join us in Copenhagen</p>
      <h2>Founding members wanted</h2>
      <p>We are building a new research group and looking for curious experimentalists who want to explore fundamental questions at the boundaries of optics, materials, and quantum science. The people who join now will be founding members of the lab — building the first experiments with us, setting up instruments as they are delivered, and producing its earliest results.</p>
      <div class="pos"><b>Postdoctoral positions</b><span>Experimental nanophotonics and quantum optics · <a href="https://employment.ku.dk/all-vacancies?show=167960">Posting and application</a></span></div>
      <div class="pos"><b>Assistant Professor (fixed term)</b><span>Nanophotonics of quantum and 2D materials · posting coming soon; informal inquiries welcome now</span></div>
      <div class="pos"><b>PhD and master's projects</b><span>Write to us</span></div>
      <p><a class="arrow" href="/join">Salaries, benefits, and how to get in touch</a></p>
    </div>
    <figure><img class="framed" src="/images/view-out.jpg" alt="The view from inside the Niels Bohr Building out over Jagtvej." width="1600" height="1066" loading="lazy"><figcaption>The view from the building, over Jagtvej.</figcaption></figure>
  </div>
</section>

</Base>

<style>
.hero{background:var(--paper-2);overflow:hidden}
.hero-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,46vw);align-items:stretch;gap:0}
.hero-text{padding:46px 44px 46px max(28px,calc((100vw - 1180px)/2 + 28px));align-self:center}
.hero-fig{margin:0;position:relative;min-height:360px}
.hero-fig img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 28%;max-width:none}
.hero-fig figcaption{position:absolute;left:0;right:0;bottom:0;margin:0;padding:10px 16px;font-size:12px;color:#fff;background:linear-gradient(transparent,rgba(0,0,0,.6))}
@media (max-width:860px){.hero-grid{grid-template-columns:1fr}.hero-text{padding:30px 28px 22px}.hero-fig{min-height:300px}}
.lede{font-size:18px;color:var(--ink-2);max-width:34em;margin:0 0 20px}
.head{display:flex;justify-content:space-between;align-items:baseline;gap:20px;flex-wrap:wrap}
.head a{font-size:14.5px;font-weight:500}
.photos{display:grid;grid-template-rows:1fr 1fr;gap:10px;height:100%;min-height:0}
.photos figure{display:flex;flex-direction:column;min-height:0;margin:0}
.photos img{flex:1 1 auto;min-height:0;width:100%;object-fit:cover}
.photos figcaption{flex:0 0 auto}
.lab-two{align-items:stretch}
@media (min-width:861px){.lab-two .photos{contain:size;grid-template-rows:1.25fr .75fr}.lab-two .photos figure:first-child img{object-position:center bottom}.lab-two .photos figure:last-child img{object-position:center 40%}}
@media (max-width:860px){.photos{grid-template-rows:auto auto;height:auto}.photos img{height:220px}}
.d h3{font-size:16.5px;margin:10px 0 5px}
.dtext :global(p){font-size:14px;color:var(--ink-2);margin:0 0 6px;line-height:1.5}
.join{background:var(--paper-2)}
h1{font-size:clamp(30px,3.6vw,40px)}
@media (min-width:1041px){.leader-home{grid-template-columns:420px 1fr;align-items:center}}
</style>
