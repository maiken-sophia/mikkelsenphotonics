---
const nav = [
  { href: '/research', label: 'Research' },
  { href: '/people', label: 'People' },
  { href: '/publications', label: 'Publications' },
  { href: '/join', label: 'Join us' },
  { href: '/contact', label: 'Contact' },
];
const path = Astro.url.pathname;
---
<header>
  <div class="wrap">
    <nav>
      <a class="brand" href="/"><b>Mikkelsen Photonics</b><small>Quantum, nonlinear and nanoscale light–matter interactions</small></a>
      <div class="navright">
        <div class="inst">Niels Bohr Institute · University of Copenhagen</div>
        <ul>{nav.map(n => <li><a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a></li>)}</ul>
      </div>
    </nav>
  </div>
</header>
<style>
header{position:sticky;top:0;z-index:20;background:color-mix(in srgb,var(--paper) 92%,transparent);backdrop-filter:blur(8px);border-bottom:1px solid var(--line)}
nav{display:flex;align-items:center;justify-content:space-between;min-height:72px;gap:24px}
.brand{text-decoration:none}
.brand b{display:block;font-weight:700;font-size:19px;letter-spacing:.05em;text-transform:uppercase;line-height:1.15}
.brand small{display:block;font-size:13px;color:var(--ink-3)}
.navright{text-align:right}
.inst{font-size:12.5px;color:var(--ink-3);margin-bottom:4px}
ul{list-style:none;margin:0;padding:0;display:flex;gap:26px;justify-content:flex-end}
ul a{text-decoration:none;font-size:14.5px;color:var(--ink-2)}
ul a:hover,ul a[aria-current]{color:var(--ink)}
ul a[aria-current]{text-decoration:underline;text-decoration-color:var(--accent);text-underline-offset:6px}
@media (max-width:820px){ul{gap:16px;flex-wrap:wrap}.inst{display:none}.brand small{display:none}}
</style>
